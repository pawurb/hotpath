          "refId": "A"
        },
        {
          "expr": "sum by (endpoint) (rate(hotpath_http_errors_total{route=~\"$route\"}[1m])) > 0",
          "legendFormat": "{{endpoint}} errors",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "HTTP time spent: $route (top 20, 5m window)",
